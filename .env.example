# Copy to .env and edit. Never commit the real .env file.
SMS_ENV=production
# Required in production, at least 32 characters. Generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SMS_SECRET_KEY=
# Everything the app stores lives under this folder (database, photos, backups, logs). Back it up.
SMS_DATA_DIR=/var/lib/sms
# Optional overrides (default to folders inside SMS_DATA_DIR):
# SMS_DATABASE_PATH=/var/lib/sms/sms.db
# SMS_BACKUP_DIR=/var/backups/sms
# SMS_LOG_DIR=/var/log/sms
SMS_SESSION_IDLE_MINUTES=60
SMS_SESSION_MAX_HOURS=12
SMS_AUTO_BACKUP=1
SMS_BACKUP_KEEP=14
SMS_MAX_UPLOAD_MB=5
# Set to 1 only when running behind a reverse proxy (nginx, Caddy...) that sets X-Forwarded-* headers.
SMS_TRUST_PROXY=1
